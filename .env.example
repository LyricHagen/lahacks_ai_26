# Single connection string. Host port is 5433 so it does not clash with a local Postgres on 5432.
# Local docker-compose default below; on Neon/Vercel paste the pooled URL.
DATABASE_URL=postgres://who2ask:who2ask@localhost:5433/who2ask

# trace | debug | info | warn | error (default: trace in development, debug in production)
LOG_LEVEL=trace

# Signs and encrypts the session cookie (Auth.js). Required. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Comma separated emails promoted to admin (and approved) when they sign up. The first account
# ever created is always admin.
ADMIN_EMAILS=

# Live model calls. Without a key every call falls back to the committed demo fixtures.
ANTHROPIC_API_KEY=
# Daily token budgets (input plus output tokens, UTC day). Defaults shown.
USER_DAILY_TOKEN_BUDGET=50000
GLOBAL_DAILY_TOKEN_BUDGET=500000

# Minimum time each live status line stays on screen while an ask is processing (ms). 0 turns
# pacing off. Default 700, so fast steps still read as visible work in the demo.
ASK_STEP_MIN_MS=700
